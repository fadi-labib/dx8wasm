{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/guardrail-hook.sh",
            "timeout": 30,
            "statusMessage": "Running guardrail checks"
          }
        ]
      }
    ]
  }
}
